<table id="mapTokensTable" class="table table-sm table-hover map-token-table">
    <thead>
        <tr>
            <th>Token</th>
            <th>Colonne</th>
            <th>Ligne</th>
            <th>Taille</th>
            <th>N°</th>
            <th>
                <button
                    type="button"
                    class="btn btn-sm btn-primary"
                    id="addMapTokenButton"
                    %1$s
                >
                    <i class="fa-solid fa-plus"></i>
                </button>
            </th>
        </tr>
    </thead>

    <tbody>
        %2$s
    </tbody>
</table>
