<div class="turn-controls">
    <button class="btn btn--nav"%1$s><i class="fa-solid fa-chevron-left"></i> Précédent</button>
    <div class="turn-info">
        <div class="turn-info__round">Round <span>%2$s</span></div>
        <div class="turn-info__name">%3$s</div>
    </div>
    <button class="btn btn--nav"%4$s>Next <i class="fa-solid fa-chevron-right"></i></button>
</div>
<button class="btn btn--danger btn--full" style="margin-top: 8px;">End Combat</button>
