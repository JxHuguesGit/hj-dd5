        <main class="%1$s">
            <div class="title-container">
                <div class="title-line title-line--left"></div>
                <span class="section-title">%2$s</span>
                <div class="title-line title-line--right"></div>
            </div>
            <div class="visual-container %3$s">
                <button title="%4$s" class="character-portrait">
                    <img src="%5$s" alt="%6$s">
                </button>
            </div>
            <div class="bloc-status">%9$s</div>
            <h1 class="character-name" title="%6$s" data-clip-auto="">%6$s</h1>
            <div class="initiative-container">
                <div class="text-center">
                    <div class="stat-label">Initiative</div>
                    <div class="stat-value">%7$s</div>
                </div>
                <div class="separator-vertical"></div>
                <div class="text-center">
                    <div class="stat-label">Classe d'armure</div>
                    <div class="stat-value text-white">%8$s</div>
                </div>
            </div>
            <div class="bloc-conditions">%10$s</div>

        </main>
