<div class="character %4$s" id="character-%3$s">
    <div class="emblem-container">
        <button title="Upload avatar">
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
        </button>
    </div>
    <div class="character-details">
        <div class="character-name">
            <span class="character-name-text">%1$s</span>
            <span class="isBenched">benched</span>
            <button title="Grant Inspiration">
                <i aria-hidden="true" class="fa-regular fa-star"></i>
            </button>
        </div>
        <div class="character-stats">%2$s</div>
    </div>
    <div class="buttons">
        <button title="Ajouter au Combat" class="btn-add">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
        </button>
        <button title="Modifier" class="btn-edit">
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
        </button>
        <div class="confirm-delete">
            <button title="Supprimer" class="btn-delete">
                <i class="fa-solid fa-trash-alt" aria-hidden="true"></i>
            </button>
            <div class="confirm-actions">
                <button class="status-yes">Oui</button>
                <button class="status-cancel">Non</button>
            </div>
        </div>
    </div>
</div>
