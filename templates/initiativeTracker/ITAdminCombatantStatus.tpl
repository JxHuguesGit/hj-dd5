        <button title="Add Lair Actions to initiative" class="lair %1$s">
            <i class="fa-solid fa-building" aria-hidden="true"></i>
        </button>
        <button title="Transform (Wild Shape, Polymorph, etc.)" class="polymorph %2$s">
            <i class="fa-solid fa-paw" aria-hidden="true"></i>
            <i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>
        </button>
        <button title="Réaction disponible ou non" class="reaction %3$s">
            <i aria-hidden="true" class="fa-solid fa-bolt"></i>
        </button>
        <button title="Action Intention utilisée" class="ready %4$s">
            <i aria-hidden="true" class="fa-solid fa-stopwatch"></i>
        </button>
        <button title="Mark as surprised" class="surprise %5$s">
            <i aria-hidden="true" class="fa-solid fa-triangle-exclamation"></i>
        </button>
        <button title="Grant Inspiration" class="inspiration %6$s">
            <i aria-hidden="true" class="fa-regular fa-star"></i>
        </button>
        <button title="Notes" class="notes %7$s">
            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
        </button>
        <button title="Voir la fiche" class="info %8$s" data-monster-id="%9$s">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        </button>
        <button class="bench" title="Retirer du combat (garder dans le groupe)">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
