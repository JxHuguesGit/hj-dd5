<div class="mb-3">
    <label for="mapTokenTokenId" class="form-label">Token</label>
    <select id="mapTokenTokenId" name="tokenId" class="form-select">
        %1$s
    </select>
</div>

<div class="row">
    <div class="col-md-6">
        <label for="mapTokenColumn" class="form-label">Colonne</label>
        <input type="number" id="mapTokenColumn" name="column" class="form-control" min="1" value="1">
    </div>

    <div class="col-md-6">
        <label for="mapTokenRow" class="form-label">Ligne</label>
        <input type="number" id="mapTokenRow" name="row" class="form-control" min="1" value="1">
    </div>
</div>
